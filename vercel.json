{
    "functions": {
        "api/checkout.ts": {
            "maxDuration": 30
        },
        "api/tts.ts": {
            "maxDuration": 60
        },
        "api/webhook.ts": {
            "maxDuration": 30
        }
    },
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "bibliavive.com.br"
                }
            ],
            "destination": "https://www.bibliavive.com.br/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}