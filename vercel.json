{
    "functions": {
        "api/checkout.ts": {
            "maxDuration": 30
        },
        "api/tts.ts": {
            "maxDuration": 60
        },
        "api/stt.ts": {
            "maxDuration": 60
        },
        "api/webhook.ts": {
            "maxDuration": 30
        },
        "api/stripe/portal.ts": {
            "maxDuration": 30
        },
        "api/verse-today.ts": {
            "maxDuration": 10
        },
        "api/r2-presigned-url.ts": {
            "maxDuration": 60
        },
        "api/r2-list-images.ts": {
            "maxDuration": 10
        },
        "api/notifications/subscribe.ts": {
            "maxDuration": 10
        },
        "api/notifications/on-publish.ts": {
            "maxDuration": 30
        },
        "api/seo.ts": {
            "maxDuration": 15
        },
        "api/scripture-thread.ts": {
            "maxDuration": 15
        }
    },
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/bible/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                },
                {
                    "key": "Service-Worker-Allowed",
                    "value": "/"
                }
            ]
        },
        {
            "source": "/registerSW.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/data/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/red_letters_verses.json",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.scripture.api.bible https://raw.githubusercontent.com https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://www.google.com https://www.google.com.br https://fonts.gstatic.com https://fonts.googleapis.com https://api.openai.com https://audio.bibliavive.com.br https://midia.bibliavive.com.br https://busca.bibliavive.com.br https://*.bibliavive.com.br https://*.workers.dev https://*.r2.cloudflarestorage.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://fcmregistrations.googleapis.com https://firebaseinstallations.googleapis.com https://*.firebaseio.com; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://www.gstatic.com; img-src 'self' data: https://*.supabase.co https://www.google-analytics.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://www.google.com https://www.google.com.br https://*.googleusercontent.com https://midia.bibliavive.com.br; media-src 'self' blob: https://audio.bibliavive.com.br; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; worker-src 'self' https://midia.bibliavive.com.br"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(self), geolocation=()"
                },
                {
                    "key": "No-Vary-Search",
                    "value": "params=(\"utm_source\" \"utm_medium\" \"utm_campaign\" \"utm_term\" \"utm_content\" \"fbclid\" \"gclid\")"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "bibliavive.com.br"
                }
            ],
            "destination": "https://www.bibliavive.com.br/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/api/notifications/unsubscribe",
            "destination": "/api/notifications/subscribe?action=unsubscribe"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/api/seo?type=index"
        },
        {
            "source": "/sitemap-artigos.xml",
            "destination": "/api/seo?type=articles"
        },
        {
            "source": "/feed.xml",
            "destination": "/api/seo?type=feed"
        },
        {
            "source": "/feed",
            "destination": "/api/seo?type=feed"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}