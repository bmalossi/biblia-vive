# Supabase (Frontend)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase (Backend/Vercel Functions - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# ElevenLabs (Para Áudio PRO com Voz Humana)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# AssemblyAI (Para Speech-to-Text no Memorial)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# Storage Cloudflare R2 (Server-side only)
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_bucket_name
VITE_R2_PUBLIC_URL=https://assets.yourdomain.com

# Sentry — Monitoramento de erros do frontend
# Obtenha o DSN em: https://sentry.io → Projeto → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Facebook App ID (Para silenciar aviso do Facebook Debugger)
VITE_FB_APP_ID=1035985160869680

# Firebase - Public config (safe for frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging VAPID Key (public key for Web Push)
VITE_FIREBASE_VAPID_KEY=

# Firebase Admin SDK Service Account (NEVER expose to client)
# Paste the FULL JSON content of your service-account key file
FIREBASE_SERVICE_ACCOUNT_JSON=

# Segredo de Autenticação dos Database Webhooks do Supabase (Vercel Functions - NEVER expose to client)
SUPABASE_WEBHOOK_SECRET=your_supabase_webhook_secret

